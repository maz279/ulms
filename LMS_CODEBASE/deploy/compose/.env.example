# ULMS local stack credentials — TEMPLATE ONLY.
# Copy to .env and fill from your secret manager. .env is gitignored;
# CI additionally blocks credential patterns via gitleaks (PLANNING/02 §4).
# NEVER commit real values. Rotate for every environment.

# Postgres (ulms schema + fineract schema share the cluster)
ULMS_DB_PASSWORD=change-me
FINERACT_DB_PASSWORD=change-me

# Keycloak bootstrap admin (dev only — bank realm users come via import)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Fineract API user for the adapter (create in Fineract after first boot)
FINERACT_USER=ulms-adapter
FINERACT_PASSWORD=change-me

# MinIO
MINIO_ROOT_USER=ulms
MINIO_ROOT_PASSWORD=change-me

# Fineract image pin (audit R1) — immutable commit-SHA tag; pin the digest of
# whatever you promote before gate sign-off (ADR-002)
FINERACT_IMAGE=apache/fineract:fd01236df6

# Grafana (compose observability — audit R1)
GRAFANA_ADMIN_PASSWORD=change-me

# Rail webhook HMAC secret (unset → verifier fails CLOSED in the api)
ULMS_RAILS_WEBHOOK_SECRET=change-me
