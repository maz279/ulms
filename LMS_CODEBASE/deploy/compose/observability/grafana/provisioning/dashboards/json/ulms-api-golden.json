{
  "title": "ULMS — API Golden Signals",
  "uid": "ulms-api-golden",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Service up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"ulms-api\"}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP request rate (by uri)",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"ulms-api\"}[1m])) by (uri)" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 latency",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"ulms-api\"}[5m])) by (le, uri))" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "Error rate (5xx)",
      "gridPos": { "h": 8, "w": 9, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"ulms-api\", status=~\"5..\"}[5m])) by (uri)" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 9, "x": 9, "y": 8 },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{job=\"ulms-api\", area=\"heap\"})" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "DB connections active",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "hikaricp_connections_active{job=\"ulms-api\"}" }]
    }
  ]
}
