{
  "title": "ULMS — EOD / Outbox / Business KPIs",
  "uid": "ulms-business",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Outbox pending (ADR-004)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "ulms_outbox_pending" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Rail webhook rejections (15m)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(increase(ulms_rail_webhook_rejected_total[15m]))" }]
    },
    {
      "id": 3, "type": "stat", "title": "SMA migrations (24h)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "sum(increase(ulms_classification_migrations_total{to=\"SMA\"}[24h]))" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Request rate by endpoint (top 10)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "topk(10, sum(rate(http_server_requests_seconds_count{job=\"ulms-api\"}[5m])) by (uri))" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "EOD batch duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "ulms_eod_batch_duration_seconds" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
