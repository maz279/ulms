{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["react-native"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
